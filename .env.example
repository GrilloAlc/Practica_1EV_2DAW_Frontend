# No hace falta crear .env.local: la web llama a /api y Vite (en local) o vercel.json (en Vercel)
# lo reenvían a la API de Render.
# Solo si quieres llamar a otra API directamente (tiene que permitir CORS), copia este archivo como
# .env.local y quita el # de la línea de abajo:
# VITE_API_URL=https://otra-api.ejemplo.com/api
